# Copy to .env and fill in. NEVER commit .env.
# On a host (Render, Railway...) set these in the dashboard instead of using a file.

# Set NODE_ENV to "production" on the host.
NODE_ENV=development
# Hosts set PORT for you.
PORT=4000
LOG_LEVEL=info

# Websites allowed to call this API from a browser (comma separated, https in production).
# Example: https://farmas.vercel.app,https://www.yourfarmas.com
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection string (Neon / Supabase). Keep ?sslmode=require for hosted databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Login tokens. A long random string (32+ characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The AI service (../ai-service). The key must be IDENTICAL in both services (16+ characters, random).
MODEL_SERVICE_URL=http://localhost:8001
MODEL_SERVICE_INTERNAL_KEY=

# How many proxies sit in front of this API. Leave empty: 1 in production, 0 locally.
# TRUST_PROXY_HOPS=1

# WhatsApp (leave empty until WhatsApp is connected).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# The "App secret" from the Meta app dashboard. REQUIRED in production: without it the webhook rejects every call.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v20.0
