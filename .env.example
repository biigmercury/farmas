# FarmAs AI settings. Copy this file to .env (in the repo root) and fill it in. NEVER commit .env.
#
# The AI service (ai-service/) reads these. OpenAI is the AI provider.

# Your OpenAI API key (https://platform.openai.com/api-keys). Keep it private. Needs credit on the account.
OPENAI_API_KEY=

# Main model for understanding messages and health assessment.
OPENAI_MODEL=gpt-6-luna
# Tried in order if the main model is busy or rate limited.
# OPENAI_FALLBACK_MODELS=gpt-5.4-mini,gpt-4.1-mini

# Speech to text for voice notes.
# OPENAI_STT_MODEL=gpt-4o-transcribe
