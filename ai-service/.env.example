# Copy to .env and fill in. NEVER commit .env.
# On a host (Render, Railway...) set these in the dashboard instead of using a file.
# (For local work the OpenAI key can instead live in the repo-root .env.)

# "production" on the host: requires the internal key below and hides the API docs page.
AI_SERVICE_ENV=development

# https://platform.openai.com/api-keys  (the account needs credit)
OPENAI_API_KEY=

# Main model, and backups used if it is busy or rate limited.
OPENAI_MODEL=gpt-6-luna
# OPENAI_FALLBACK_MODELS=gpt-5.4-mini,gpt-4.1-mini

# Voice notes.
# OPENAI_STT_MODEL=gpt-4o-transcribe

# Shared secret with the API. IDENTICAL value in api/.env (16+ characters, random). Required in production.
MODEL_SERVICE_INTERNAL_KEY=

# Limits: one AI call, and one whole request including retries (seconds).
# AI_TIMEOUT_S=20
# AI_DEADLINE_S=30
