# Copy this file to .env.local and edit. .env.local is git-ignored.
# On Vercel, add the same names under Project Settings -> Environment Variables.
#
# IMPORTANT: NEXT_PUBLIC_* values are baked into the website when it is BUILT and are visible to every
# visitor. Never put a secret key here. Change a value, then redeploy.

# Address of the FarmAs API. Leave empty to run the app on built-in sample data (no server needed).
# Local:       http://localhost:4000
# Production:  https://your-api.onrender.com   (must be https)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional "Use demo account" button on the login page. These are PUBLIC: anyone can read them in the website.
# Only use a throwaway demo farm. Remove both lines for a real public launch.
NEXT_PUBLIC_DEMO_EMAIL=don@donsfarm.ng
NEXT_PUBLIC_DEMO_PASSWORD=password123
